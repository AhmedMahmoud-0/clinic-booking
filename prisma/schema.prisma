// MERUNO Medical Clinics — domain schema (Phases 2A–2D)
// Prisma 7 configuration and datasource URL are managed by prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleExceptionType {
  BLOCKED
  EXTRA_HOURS
}

enum ServiceType {
  CONSULTATION
  FOLLOW_UP
  OTHER
}

enum PatientContactType {
  PHONE
  EMAIL
}

enum PatientAddressType {
  HOME
  WORK
  OTHER
}

enum PatientConsentType {
  PRIVACY_NOTICE
  PERSONAL_DATA_PROCESSING
  GENERAL_TREATMENT
  EMAIL_COMMUNICATION
  PHONE_COMMUNICATION
  EXTERNAL_DIAGNOSTIC_DATA_SHARING
}

enum PatientConsentDecision {
  GRANTED
  REFUSED
  WITHDRAWN
}

enum PatientConsentCaptureMethod {
  WRITTEN
  VERBAL
}

enum PatientConsentSignerType {
  PATIENT
  LEGAL_GUARDIAN
}

enum PatientRecordType {
  FULL
  DIAGNOSTIC_ONLY
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum PatientRelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  OTHER
}

enum PatientGuardianEvidenceType {
  BIRTH_CERTIFICATE
  FAMILY_REGISTRY_EXTRACT
  COURT_ORDER
  CUSTODY_ORDER
  OTHER_OFFICIAL_DOCUMENT
}

enum AppointmentSource {
  PUBLIC_WEBSITE
  PATIENT_PORTAL
  RECEPTION
}

enum GuestAppointmentResolutionStatus {
  PENDING_VERIFICATION
  LINKED
}

enum PatientAppointmentOverlapReason {
  CLINIC_DIRECTED_RESCHEDULE
  CLINICIAN_REQUESTED_FOLLOW_UP
  PATIENT_REQUESTED_EXCEPTION
  SAME_DAY_SERVICE_COORDINATION
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
}

enum AppointmentChangeSource {
  STAFF
  PATIENT
  SYSTEM
}

enum QueueEntryType {
  APPOINTMENT
  WALK_IN
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  LEFT
  CANCELLED
}

enum IdentityElementType {
  FULL_NAME
  DATE_OF_BIRTH
  PHONE
  NATIONAL_ID
  PASSPORT
  MRN
  OTHER
}

enum IdentityVerificationResult {
  VERIFIED
  FAILED
  ESCALATED
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NursingTaskType {
  RECORD_VITAL_SIGNS
  REPEAT_VITAL_SIGNS
  PRE_CONSULTATION_ASSESSMENT
  PROCEDURE_PREPARATION
  OTHER
}

enum NursingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ESCALATED
  CANCELLED
}

enum ClinicalNoteType {
  INITIAL_ASSESSMENT
  FOLLOW_UP
  PROGRESS
  OTHER
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum ReferralType {
  INTERNAL
  EXTERNAL
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Phase 2C — Laboratory and radiology diagnostic workflows.
// Schema only. PostgreSQL migrations and database writes remain deferred to 2E.
// -----------------------------------------------------------------------------

enum ExternalLabIntakeSource {
  PAPER
  ELECTRONIC
}

enum ExternalLabReferralStatus {
  REFERRED
  RESULT_RECEIVED
  REVIEWED
  CANCELLED
}

enum RadiologyExamPreparationStatus {
  PENDING
  CONFIRMED
  NOT_REQUIRED
  ISSUE_REPORTED
}

enum DiagnosticOrderPriority {
  ROUTINE
  URGENT
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabOrderItemStatus {
  PENDING
  COLLECTED
  RECEIVED
  REJECTED
  PROCESSING
  RESULTED
  CANCELLED
}

enum LabSampleStatus {
  COLLECTED
  RECEIVED
  REJECTED
}

enum LabResultStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  RELEASED
  CANCELLED
}

enum LabResultValueType {
  NUMERIC
  TEXT
  BOOLEAN
}

enum LabAbnormalFlag {
  NOT_INDICATED
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

enum DiagnosticReviewDecision {
  REVIEWED
  FOLLOW_UP_REQUIRED
}

enum LabResultApprovalDecision {
  APPROVED
  REJECTED
}

enum CriticalCommunicationMethod {
  PHONE
  IN_PERSON
  SECURE_MESSAGE
}

enum CriticalCommunicationStatus {
  PENDING
  NOTIFIED
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum RadiologyModality {
  DIGITAL_XRAY
  ULTRASOUND
}

enum RadiologyOrderStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RadiologyOrderItemStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RadiologyExamStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PregnancyScreeningResult {
  NOT_APPLICABLE
  NEGATIVE
  POSITIVE
  DECLINED
}

enum RadiologyPregnancyReviewDecision {
  AUTHORIZE_AFTER_REVIEW
  DEFER_EXAM
}

enum ExternalRadiologyReferralStatus {
  REFERRED
  RESULT_RECEIVED
  REVIEWED
}

// Physician triage decision at order time; distinct from the formal exam-day screening result.
enum RadiologyOrderPregnancyAssessment {
  SCREENING_REQUIRED
  NOT_INDICATED
}

enum RadiologyReportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RELEASED
  CANCELLED
}

enum RadiologyReportApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum EmployeeRole {
  RECEPTION
  DOCTOR
  NURSE
  LAB_STAFF
  RADIOLOGY_STAFF
  RADIOLOGIST
  CASHIER
  CLINIC_MANAGER
  SYSTEM_ADMIN
}

enum EmployeeRoleAssignmentStatus {
  ACTIVE
  REVOKED
}

enum PatientAccessGrantStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum PatientAccessScope {
  VIEW_PROFILE
  MANAGE_PROFILE
  BOOK_APPOINTMENTS
  MANAGE_APPOINTMENTS
  VIEW_BILLING
  VIEW_MEDICAL_RECORDS
  VIEW_DIAGNOSTIC_RESULTS
}

model Specialty {
  id          String            @id @default(cuid())
  code        String            @unique @db.VarChar(40)
  name        String            @unique @db.VarChar(100)
  description String?           @db.Text
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  doctors     DoctorSpecialty[]
  referrals   Referral[]

  @@index([isActive, sortOrder])
}

model Employee {
  id                         String                     @id @default(cuid())
  employeeNumber             String                     @unique @db.VarChar(30)
  firstName                  String                     @db.VarChar(100)
  lastName                   String                     @db.VarChar(100)
  workEmail                  String?                    @unique @db.VarChar(254)
  phone                      String?                    @db.VarChar(30)
  status                     EmployeeStatus             @default(ACTIVE)
  hiredOn                    DateTime?                  @db.Date
  endedOn                    DateTime?                  @db.Date
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @db.Timestamptz(3)
  doctorProfile                    DoctorProfile?
  createdScheduleExceptions        DoctorScheduleException[] @relation("ScheduleExceptionCreator")
  createdClinicScheduleExceptions  ClinicScheduleException[] @relation("ClinicScheduleExceptionCreator")
  verifiedGuardianRelationships    PatientRelationship[]     @relation("GuardianRelationshipVerifier")
  deactivatedPatientRelationships   PatientRelationship[]     @relation("PatientRelationshipDeactivator")
  recordedPatientConsents           PatientConsent[]            @relation("PatientConsentRecorder")
  createdAppointments              Appointment[]              @relation("AppointmentCreator")
  appointmentStatusChanges         AppointmentStatusHistory[] @relation("AppointmentStatusActor")
  createdQueueEntries               QueueEntry[]                @relation("QueueEntryCreator")
  identityVerifications             IdentityVerification[]     @relation("IdentityVerifier")
  createdEncounters                 Encounter[]                 @relation("EncounterCreator")
  authoredClinicalNotes             ClinicalNote[]              @relation("ClinicalNoteAuthor")
  recordedVitalSigns                VitalSign[]                 @relation("VitalSignRecorder")
  assignedNursingTasks              NursingTask[]               @relation("NursingTaskAssignee")
  createdNursingTasks               NursingTask[]               @relation("NursingTaskCreator")
  completedNursingTasks             NursingTask[]               @relation("NursingTaskCompleter")
  cancelledNursingTasks             NursingTask[]               @relation("NursingTaskCanceller")
  resolvedNursingTaskEscalations    NursingTask[]               @relation("NursingTaskEscalationResolver")
  recordedDiagnoses                 EncounterDiagnosis[]        @relation("EncounterDiagnosisAuthor")
  authoredPrescriptions             Prescription[]              @relation("PrescriptionAuthor")
  clinicalAmendments                ClinicalAmendment[]         @relation("ClinicalAmendmentAuthor")
  createdReferrals                  Referral[]                  @relation("ReferralCreator")
  orderedLabOrders                  LabOrder[]                   @relation("LabOrderAuthor")
  collectedLabSamples               LabSample[]                  @relation("LabSampleCollector")
  receivedLabSamples                LabSample[]                  @relation("LabSampleReceiver")
  createdExternalLabIntakes         ExternalLabIntake[]           @relation("ExternalLabIntakeCreator")
  patientRecordTypeHistoryChanges   PatientRecordTypeHistory[]    @relation("PatientRecordTypeHistoryActor")
  createdExternalLabReferrals       ExternalLabReferral[]         @relation("ExternalLabReferralCreator")
  receivedExternalLabReferralResults ExternalLabReferral[]        @relation("ExternalLabReferralResultReceiver")
  reviewedExternalLabReferrals      ExternalLabReferral[]         @relation("ExternalLabReferralReviewer")
  cancelledExternalLabReferrals     ExternalLabReferral[]         @relation("ExternalLabReferralCanceller")
  authoredLabResults                LabResult[]                  @relation("LabResultAuthor")
  approvedLabResults                LabResult[]                  @relation("LabResultApprover")
  labResultReviews                  LabResultReview[]             @relation("LabResultReviewer")
  labClinicalReviews                LabClinicalReview[]           @relation("LabClinicalReviewer")
  notifiedLabCriticalCommunications LabCriticalCommunication[]    @relation("LabCriticalNotifier")
  acknowledgedLabCritical           LabCriticalCommunication[]    @relation("LabCriticalAcknowledger")
  orderedRadiologyOrders            RadiologyOrder[]              @relation("RadiologyOrderAuthor")
  performedRadiologyExams           RadiologyExam[]               @relation("RadiologyExamPerformer")
  checkedRadiologyPreparations      RadiologyExam[]               @relation("RadiologyExamPreparationChecker")
  recordedPregnancyScreenings       RadiologyPregnancyScreening[] @relation("PregnancyScreeningRecorder")
  reviewedPregnancyScreenings       RadiologyPregnancyScreening[] @relation("PregnancyScreeningReviewer")
  assessedRadiologyOrderItems       RadiologyOrderItem[]         @relation("RadiologyOrderItemPregnancyAssessor")
  authoredRadiologyReports          RadiologyReport[]             @relation("RadiologyReportAuthor")
  approvedRadiologyReports          RadiologyReport[]             @relation("RadiologyReportApprover")
  radiologyReportReviews            RadiologyReportReview[]       @relation("RadiologyReportReviewer")
  radiologyClinicalReviews          RadiologyClinicalReview[]     @relation("RadiologyClinicalReviewer")
  notifiedRadiologyCritical         RadiologyCriticalCommunication[] @relation("RadiologyCriticalNotifier")
  acknowledgedRadiologyCritical     RadiologyCriticalCommunication[] @relation("RadiologyCriticalAcknowledger")
  createdExternalRadiologyReferrals  ExternalRadiologyReferral[] @relation("ExternalRadiologyReferralCreator")
  receivedExternalRadiologyResults   ExternalRadiologyReferral[] @relation("ExternalRadiologyReferralResultReceiver")
  reviewedExternalRadiologyReferrals ExternalRadiologyReferral[] @relation("ExternalRadiologyReferralReviewer")

  createdInvoices                 Invoice[]                     @relation("InvoiceCreator")
  collectedPayments               Payment[]                     @relation("PaymentCollector")
  requestedDiscountApprovals      DiscountApproval[]            @relation("DiscountRequester")
  decidedDiscountApprovals        DiscountApproval[]            @relation("DiscountDecider")
  requestedRefunds                Refund[]                      @relation("RefundRequester")
  approvedRefunds                 Refund[]                      @relation("RefundApprover")
  completedRefunds                Refund[]                      @relation("RefundExecutor")
  decidedRefunds                  Refund[]                      @relation("RefundDecider")
  recordedComplaints              Complaint[]                  @relation("ComplaintRecorder")
  assignedComplaints              Complaint[]                  @relation("ComplaintAssignee")
  complaintEvents                 ComplaintEvent[]             @relation("ComplaintEventActor")
  reportedIncidents               IncidentReport[]             @relation("IncidentReporter")
  assignedIncidents               IncidentReport[]             @relation("IncidentAssignee")
  uploadedAttachments             Attachment[]                 @relation("AttachmentUploader")
  receivedNotifications           Notification[]               @relation("EmployeeNotificationRecipient")
  auditLogs                       AuditLog[]                   @relation("AuditActor")
  @@index([status, lastName, firstName])
  authAccount EmployeeAccount? @relation("EmployeeAuthAccount")
  linkedEmployeeAccounts EmployeeAccount[] @relation("EmployeeAccountLinker")
  verifiedPatientAccounts PatientAccount[] @relation("PatientAccountVerifier")
  roleAssignments EmployeeRoleAssignment[] @relation("EmployeeRoleAssignments")
  grantedRoleAssignments EmployeeRoleAssignment[] @relation("EmployeeRoleGrantors")
  revokedRoleAssignments EmployeeRoleAssignment[] @relation("EmployeeRoleRevokers")
  requestedPatientAccessGrants PatientAccessGrant[] @relation("PatientAccessGrantEmployeeRequester")
  verifiedPatientAccessGrants PatientAccessGrant[] @relation("PatientAccessGrantVerifier")
  linkedGuestAppointmentContacts GuestAppointmentContact[] @relation("GuestAppointmentResolver")
  authorizedPatientOverlapExceptions AppointmentPatientOverlapException[] @relation("PatientOverlapExceptionApprover")
}

model DoctorProfile {
  id                   String                    @id @default(cuid())
  employeeId           String                    @unique
  professionalTitle    String?                   @db.VarChar(120)
  publicDisplayName    String?                   @db.VarChar(160)
  publicBio            String?                   @db.Text
  yearsOfExperience    Int?
  isBookable           Boolean                   @default(true)
  isPubliclyVisible    Boolean                   @default(true)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  employee             Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  specialties          DoctorSpecialty[]
  services             DoctorService[]
  weeklySchedules      DoctorWeeklySchedule[]
  scheduleExceptions   DoctorScheduleException[]
  queueEntries         QueueEntry[]
  encounters           Encounter[]
  targetReferrals      Referral[] @relation("ReferralTargetDoctor")

  @@index([isBookable, isPubliclyVisible])
}

model DoctorSpecialty {
  doctorId    String
  specialtyId String
  isPrimary   Boolean       @default(false)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([doctorId, specialtyId])
  @@index([specialtyId, isPrimary])
}

model ServiceCatalog {
  id          String         @id @default(cuid())
  code        String         @unique @db.VarChar(40)
  name        String         @db.VarChar(140)
  type        ServiceType    @default(CONSULTATION)
  description String?        @db.Text
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  doctors     DoctorService[]

  invoiceItems InvoiceItem[]
  @@index([type, isActive])
  @@index([name])
}

model DoctorService {
  id             String        @id @default(cuid())
  doctorId       String
  serviceId      String
  durationMinutes Int
  price          Decimal       @db.Decimal(10, 2)
  currencyCode   String        @default("EGP") @db.Char(3)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service        ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointments   Appointment[]

  @@unique([doctorId, serviceId])
  @@unique([id, doctorId])
  @@index([serviceId, isActive])
  @@index([doctorId, isActive])
}

model DoctorWeeklySchedule {
  id                String        @id @default(cuid())
  doctorId          String
  weekday           Weekday
  // Minutes after midnight in the clinic's configured time zone (0–1440).
  startMinuteOfDay  Int
  endMinuteOfDay    Int
  effectiveFrom     DateTime      @default(now()) @db.Date
  effectiveUntil    DateTime?     @db.Date
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  doctor            DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, weekday, isActive])
  @@index([doctorId, effectiveFrom, effectiveUntil])
}

model DoctorScheduleException {
  id                  String                 @id @default(cuid())
  doctorId            String
  type                ScheduleExceptionType
  startsAt            DateTime               @db.Timestamptz(3)
  endsAt              DateTime               @db.Timestamptz(3)
  reason              String?                @db.VarChar(500)
  createdByEmployeeId String?
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  doctor              DoctorProfile          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy           Employee?              @relation("ScheduleExceptionCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([doctorId, startsAt, endsAt])
  @@index([createdByEmployeeId])
}

// Single-branch clinic opening windows. Multiple non-overlapping intervals per
// weekday are allowed to represent split shifts and breaks.
model ClinicWeeklySchedule {
  id               String   @id @default(cuid())
  weekday          Weekday
  // Minutes after midnight in the clinic's configured time zone (0–1440).
  startMinuteOfDay Int
  endMinuteOfDay   Int
  effectiveFrom    DateTime @default(now()) @db.Date
  effectiveUntil   DateTime? @db.Date
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@index([weekday, isActive])
  @@index([effectiveFrom, effectiveUntil])
}

// One-off clinic closures or extra operating hours. All timestamps are stored
// as instants; callers must convert clinic-local times using clinic-time.ts.
model ClinicScheduleException {
  id                  String                @id @default(cuid())
  type                ScheduleExceptionType
  startsAt            DateTime              @db.Timestamptz(3)
  endsAt              DateTime              @db.Timestamptz(3)
  reason              String?               @db.VarChar(500)
  createdByEmployeeId String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  createdBy           Employee?             @relation("ClinicScheduleExceptionCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
  @@index([createdByEmployeeId])
}

model Patient {
  id            String                @id @default(cuid())
  mrn           String                @unique @db.VarChar(30)
  recordType    PatientRecordType     @default(FULL)
  firstName     String                @db.VarChar(100)
  middleName    String?               @db.VarChar(100)
  lastName      String                @db.VarChar(100)
  preferredName String?               @db.VarChar(100)
  dateOfBirth   DateTime?             @db.Date
  gender        PatientGender?
  isActive      Boolean               @default(true)
  appointmentScheduleVersion Int      @default(0)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  contacts      PatientContact[]
  addresses     PatientAddress[]
  emergencyContacts PatientEmergencyContact[]
  consentRecords PatientConsent[] @relation("PatientConsentSubject")
  consentsSigned PatientConsent[] @relation("PatientConsentSigner")
  relationships PatientRelationship[] @relation("PatientRelationships")
  relatedTo     PatientRelationship[] @relation("RelatedPatients")
  appointmentStatusChanges AppointmentStatusHistory[] @relation("AppointmentStatusPatientActor")
  appointments  Appointment[]
  queueEntries  QueueEntry[]
  identityVerifications IdentityVerification[]
  encounters    Encounter[]
  externalLabIntakes ExternalLabIntake[]
  recordTypeHistory PatientRecordTypeHistory[]

  invoices      Invoice[]
  complaints    Complaint[]
  attachments   Attachment[]
  notifications Notification[] @relation("PatientNotificationRecipient")
  incidentReports IncidentReport[]
  @@index([lastName, firstName])
  @@index([isActive, createdAt])
  authAccount PatientAccount?
  accessGrantsAsSubject PatientAccessGrant[] @relation("PatientAccessGrantSubject")
  accessGrantsAsGrantee PatientAccessGrant[] @relation("PatientAccessGrantGrantee")
  approvedAccessGrants PatientAccessGrant[] @relation("PatientAccessGrantPatientApprover")
  resolvedGuestAppointmentContacts GuestAppointmentContact[] @relation("GuestAppointmentResolvedPatient")
  appointmentOverlapExceptions AppointmentPatientOverlapException[] @relation("PatientOverlapExceptionPatient")
}

model PatientContact {
  id               String             @id @default(cuid())
  patientId        String
  type             PatientContactType
  value            String             @db.VarChar(254)
  normalizedValue  String             @db.VarChar(254)
  isPrimary        Boolean            @default(false)
  isActive         Boolean            @default(true)
  verifiedAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, type, normalizedValue])
  @@index([type, normalizedValue])
  @@index([patientId, type, isPrimary])
}


model PatientAddress {
  id            String            @id @default(cuid())
  patientId     String
  type          PatientAddressType @default(HOME)
  addressLine1  String            @db.VarChar(180)
  addressLine2  String?           @db.VarChar(180)
  district      String?           @db.VarChar(100)
  city          String            @db.VarChar(100)
  governorate   String            @db.VarChar(100)
  postalCode    String?           @db.VarChar(20)
  countryCode   String            @default("EG") @db.Char(2)
  isPrimary     Boolean           @default(false)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, isActive, isPrimary])
  @@index([patientId, city, governorate])
}

model PatientEmergencyContact {
  id                 String                  @id @default(cuid())
  patientId          String
  fullName           String                  @db.VarChar(180)
  relationshipType   PatientRelationshipType
  phone              String                  @db.VarChar(30)
  normalizedPhone    String                  @db.VarChar(15)
  isPrimary          Boolean                 @default(false)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  patient            Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, isActive, isPrimary])
  @@index([patientId, normalizedPhone])
}

model PatientConsent {
  id                  String                      @id @default(cuid())
  patientId           String
  consentType         PatientConsentType
  decision            PatientConsentDecision
  captureMethod       PatientConsentCaptureMethod
  documentVersion     String                      @db.VarChar(40)
  signerPatientId     String
  signerType          PatientConsentSignerType
  signerNameSnapshot  String                      @db.VarChar(220)
  recordedByEmployeeId String
  recordedAt          DateTime                    @default(now()) @db.Timestamptz(3)
  patient             Patient                     @relation("PatientConsentSubject", fields: [patientId], references: [id], onDelete: Restrict)
  signerPatient       Patient                     @relation("PatientConsentSigner", fields: [signerPatientId], references: [id], onDelete: Restrict)
  recordedByEmployee  Employee                    @relation("PatientConsentRecorder", fields: [recordedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([patientId, consentType, recordedAt])
  @@index([signerPatientId, recordedAt])
  @@index([recordedByEmployeeId, recordedAt])
  externalLabReferral ExternalLabReferral? @relation("ExternalLabReferralConsent")
  externalRadiologyReferral ExternalRadiologyReferral? @relation("ExternalRadiologyReferralConsent")
}

model PatientRelationship {
  id                           String                  @id @default(cuid())
  patientId                    String
  relatedPatientId             String
  relationshipType             PatientRelationshipType
  isLegalGuardian              Boolean                 @default(false)
  guardianVerifiedAt           DateTime?               @db.Timestamptz(3)
  guardianVerifiedByEmployeeId String?
  guardianEvidenceType         PatientGuardianEvidenceType?
  guardianEvidenceAttachmentId String?                   @unique
  guardianVerificationLegacy   Boolean                   @default(false)
  isActive                     Boolean                   @default(true)
  deactivatedAt                DateTime?                 @db.Timestamptz(3)
  deactivatedByEmployeeId      String?
  createdAt                    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  patient                      Patient                 @relation("PatientRelationships", fields: [patientId], references: [id], onDelete: Restrict)
  relatedPatient               Patient                 @relation("RelatedPatients", fields: [relatedPatientId], references: [id], onDelete: Restrict)
  guardianVerifiedBy           Employee?               @relation("GuardianRelationshipVerifier", fields: [guardianVerifiedByEmployeeId], references: [id], onDelete: Restrict)
  guardianEvidenceAttachment   Attachment?             @relation("PatientGuardianEvidence", fields: [guardianEvidenceAttachmentId], references: [id], onDelete: Restrict)
  deactivatedBy                Employee?                @relation("PatientRelationshipDeactivator", fields: [deactivatedByEmployeeId], references: [id], onDelete: Restrict)

  @@unique([patientId, relatedPatientId])
  @@index([relatedPatientId, isLegalGuardian])
  @@index([guardianVerifiedByEmployeeId])
  @@index([deactivatedByEmployeeId])
  @@index([patientId, createdAt])
  @@index([patientId, isActive, createdAt])
  accessGrants PatientAccessGrant[]
}

// -----------------------------------------------------------------------------
// Phase 2B — Appointments, reception queue, and clinical records.
// This is a schema-only update; no migration or database write is included.
// -----------------------------------------------------------------------------

model Appointment {
  id                   String            @id @default(cuid())
  bookingReference     String            @unique @db.VarChar(24)
  patientId            String?
  doctorId             String
  doctorServiceId      String
  consultationRoomId   String?
  source               AppointmentSource
  status               AppointmentStatus @default(CONFIRMED)
  startsAt             DateTime          @db.Timestamptz(3)
  endsAt               DateTime          @db.Timestamptz(3)
  durationMinutes      Int
  bookedPrice          Decimal           @db.Decimal(10, 2)
  currencyCode         String            @default("EGP") @db.Char(3)
  reasonForVisit       String?           @db.VarChar(1000)
  createdByEmployeeId  String?
  confirmedAt          DateTime          @default(now()) @db.Timestamptz(3)
  cancelledAt          DateTime?         @db.Timestamptz(3)
  cancellationReason   String?           @db.VarChar(500)
  checkedInAt          DateTime?         @db.Timestamptz(3)
  completedAt          DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  patient              Patient?          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  guestContact         GuestAppointmentContact?
  doctorService        DoctorService     @relation(fields: [doctorServiceId, doctorId], references: [id, doctorId], onDelete: Restrict)
  consultationRoom     ConsultationRoom? @relation(fields: [consultationRoomId], references: [id], onDelete: Restrict)
  createdByEmployee    Employee?         @relation("AppointmentCreator", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  statusHistory        AppointmentStatusHistory[]
  queueEntry           QueueEntry?
  identityVerifications IdentityVerification[]
  encounter            Encounter?
  patientOverlapExceptionsGranted AppointmentPatientOverlapException[] @relation("PatientOverlapExceptionSubject")
  patientOverlapExceptionsAgainst AppointmentPatientOverlapException[] @relation("PatientOverlapExceptionConflict")

  complaints Complaint[]
  @@index([patientId, startsAt])
  @@index([doctorId, startsAt, endsAt])
  @@index([consultationRoomId, startsAt, endsAt])
  @@index([status, startsAt])
  @@index([createdByEmployeeId])
}

model AppointmentPatientOverlapException {
  id                         String                              @id @default(cuid())
  appointmentId              String
  conflictingAppointmentId   String
  patientId                  String
  authorizedByEmployeeId     String
  reasonCode                 PatientAppointmentOverlapReason
  appointmentStartsAt        DateTime                            @db.Timestamptz(3)
  appointmentEndsAt          DateTime                            @db.Timestamptz(3)
  conflictingStartsAt        DateTime                            @db.Timestamptz(3)
  conflictingEndsAt          DateTime                            @db.Timestamptz(3)
  transactionId              BigInt                              @default(dbgenerated("txid_current()")) @db.BigInt
  createdAt                  DateTime                            @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(6)

  appointment                Appointment                         @relation("PatientOverlapExceptionSubject", fields: [appointmentId], references: [id], onDelete: Restrict, map: "AppointmentPatientOverlapException_subject_fkey")
  conflictingAppointment     Appointment                         @relation("PatientOverlapExceptionConflict", fields: [conflictingAppointmentId], references: [id], onDelete: Restrict, map: "AppointmentPatientOverlapException_conflict_fkey")
  patient                    Patient                             @relation("PatientOverlapExceptionPatient", fields: [patientId], references: [id], onDelete: Restrict, map: "AppointmentPatientOverlapException_patient_fkey")
  authorizedByEmployee       Employee                            @relation("PatientOverlapExceptionApprover", fields: [authorizedByEmployeeId], references: [id], onDelete: Restrict, map: "AppointmentPatientOverlapException_actor_fkey")

  @@unique([appointmentId, conflictingAppointmentId, transactionId], map: "AppointmentPatientOverlapException_pair_transaction_key")
  @@index([patientId, createdAt], map: "AppointmentPatientOverlapException_patient_createdAt_idx")
  @@index([authorizedByEmployeeId, createdAt], map: "AppointmentPatientOverlapException_actor_createdAt_idx")
  @@index([conflictingAppointmentId, createdAt], map: "AppointmentPatientOverlapException_conflict_createdAt_idx")
}

model GuestAppointmentContact {
  id                    String                          @id @default(cuid())
  appointmentId         String                          @unique
  fullName              String                          @db.VarChar(180)
  phone                 String                          @db.VarChar(30)
  normalizedPhone       String                          @db.VarChar(15)
  email                 String?                         @db.VarChar(254)
  resolutionStatus      GuestAppointmentResolutionStatus @default(PENDING_VERIFICATION)
  resolvedPatientId     String?
  resolvedByEmployeeId  String?
  resolvedAt            DateTime?                       @db.Timestamptz(3)
  manageTokenHash       String                          @unique @db.Char(64)
  manageTokenIssuedAt   DateTime                        @default(now()) @db.Timestamptz(3)
  createdAt             DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                        @updatedAt @db.Timestamptz(3)

  appointment           Appointment                     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  resolvedPatient       Patient?                        @relation("GuestAppointmentResolvedPatient", fields: [resolvedPatientId], references: [id], onDelete: Restrict)
  resolvedByEmployee    Employee?                       @relation("GuestAppointmentResolver", fields: [resolvedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([normalizedPhone, createdAt])
  @@index([resolutionStatus, createdAt])
  @@index([resolvedPatientId, resolvedAt])
}

model ConsultationRoom {
  id          String        @id @default(cuid())

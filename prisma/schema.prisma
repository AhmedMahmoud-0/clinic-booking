  encounter                Encounter                 @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  consent                  PatientConsent            @relation("ExternalLabReferralConsent", fields: [consentId], references: [id], onDelete: Restrict)
  createdByEmployee        Employee                  @relation("ExternalLabReferralCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  resultReceivedByEmployee Employee?                 @relation("ExternalLabReferralResultReceiver", fields: [resultReceivedByEmployeeId], references: [id], onDelete: Restrict)
  reviewedByEmployee       Employee?                 @relation("ExternalLabReferralReviewer", fields: [reviewedByEmployeeId], references: [id], onDelete: Restrict)
  cancelledByEmployee      Employee?                 @relation("ExternalLabReferralCanceller", fields: [cancelledByEmployeeId], references: [id], onDelete: Restrict)

  @@index([encounterId, referredAt])
  @@index([status, referredAt])
  @@index([resultReceivedByEmployeeId, resultReceivedAt])
  @@index([reviewedByEmployeeId, reviewedAt])
}

model LabOrder {
  id                  String                 @id @default(cuid())
  orderReference      String                 @unique @db.VarChar(30)
  encounterId         String?
  orderedByEmployeeId String?
  externalIntakeId    String?                @unique
  status              LabOrderStatus         @default(ORDERED)
  priority            DiagnosticOrderPriority @default(ROUTINE)
  clinicalNotes       String?                @db.VarChar(1000)
  orderedAt           DateTime               @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?              @db.Timestamptz(3)
  cancelledAt         DateTime?              @db.Timestamptz(3)
  cancellationReason  String?                @db.VarChar(500)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  encounter           Encounter?             @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  orderedByEmployee   Employee?              @relation("LabOrderAuthor", fields: [orderedByEmployeeId], references: [id], onDelete: Restrict)
  externalIntake      ExternalLabIntake?     @relation(fields: [externalIntakeId], references: [id], onDelete: Restrict)
  items               LabOrderItem[]

  @@index([encounterId, orderedAt])
  @@index([status, priority, orderedAt])
  @@index([orderedByEmployeeId, orderedAt])
}

model LabOrderItem {
  id                  String              @id @default(cuid())
  labOrderId          String
  labTestId           String
  status              LabOrderItemStatus  @default(PENDING)
  priceSnapshot       Decimal             @db.Decimal(10, 2)
  currencyCode        String              @default("EGP") @db.Char(3)
  collectionNotes     String?             @db.VarChar(500)
  collectedAt         DateTime?           @db.Timestamptz(3)
  receivedAt          DateTime?           @db.Timestamptz(3)
  processedAt         DateTime?           @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)

  labOrder            LabOrder            @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  labTest             LabTest             @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  sampleAssignments   LabSampleItem[]
  result              LabResult?

  invoiceItems InvoiceItem[]
  @@unique([labOrderId, labTestId])
  @@index([status, createdAt])
  @@index([labTestId, createdAt])
}

model LabSample {
  id                    String          @id @default(cuid())
  sampleNumber          String          @unique @db.VarChar(30)
  status                LabSampleStatus @default(COLLECTED)
  specimenTypeSnapshot  String?         @db.VarChar(100)
  collectedByEmployeeId String
  receivedByEmployeeId  String?
  collectedAt           DateTime        @default(now()) @db.Timestamptz(3)
  receivedAt            DateTime?       @db.Timestamptz(3)
  rejectionReason       String?         @db.VarChar(500)
  notes                 String?         @db.VarChar(500)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  collectedByEmployee   Employee        @relation("LabSampleCollector", fields: [collectedByEmployeeId], references: [id], onDelete: Restrict)
  receivedByEmployee    Employee?       @relation("LabSampleReceiver", fields: [receivedByEmployeeId], references: [id], onDelete: Restrict)
  items                 LabSampleItem[]

  @@index([status, collectedAt])
  @@index([receivedByEmployeeId, receivedAt])
}

model LabSampleItem {
  id             String       @id @default(cuid())
  sampleId       String
  orderItemId    String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  sample         LabSample    @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  orderItem      LabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([sampleId, orderItemId])
  @@index([sampleId])
  @@index([orderItemId, createdAt])
}

model LabResult {
  id                   String          @id @default(cuid())
  orderItemId          String          @unique
  status               LabResultStatus @default(DRAFT)
  resultSummary        String?         @db.Text
  authoredByEmployeeId String
  approvedByEmployeeId String?
  resultedAt           DateTime        @default(now()) @db.Timestamptz(3)
  approvedAt           DateTime?       @db.Timestamptz(3)
  releasedAt           DateTime?       @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)

  orderItem            LabOrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  authoredByEmployee   Employee        @relation("LabResultAuthor", fields: [authoredByEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee   Employee?       @relation("LabResultApprover", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  values               LabResultValue[]
  reviews              LabResultReview[]
  clinicalReviews      LabClinicalReview[]
  criticalCommunications LabCriticalCommunication[]

  attachments Attachment[]
  @@index([status, resultedAt])
  @@index([approvedByEmployeeId, approvedAt])
}

model LabResultValue {
  id                    String             @id @default(cuid())
  labResultId           String
  componentCodeSnapshot String             @db.VarChar(40)
  componentNameSnapshot String             @db.VarChar(160)
  valueType             LabResultValueType
  valueText             String?            @db.VarChar(1000)
  valueNumeric          Decimal?           @db.Decimal(16, 5)
  valueBoolean          Boolean?
  unitSnapshot          String?            @db.VarChar(40)
  referenceRangeSnapshot String?           @db.VarChar(160)
  abnormalFlag          LabAbnormalFlag    @default(NOT_INDICATED)
  sortOrder             Int                @default(0)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  labResult             LabResult          @relation(fields: [labResultId], references: [id], onDelete: Restrict)

  @@index([labResultId, sortOrder])
  @@index([abnormalFlag])
}

model LabResultReview {
  id                 String                    @id @default(cuid())
  labResultId        String
  reviewerEmployeeId String
  decision           LabResultApprovalDecision
  comments           String?                   @db.VarChar(1000)
  reviewedAt         DateTime                  @default(now()) @db.Timestamptz(3)
  labResult          LabResult                 @relation(fields: [labResultId], references: [id], onDelete: Restrict)
  reviewer           Employee                  @relation("LabResultReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@index([labResultId, reviewedAt])
  @@index([reviewerEmployeeId, reviewedAt])
}

model LabClinicalReview {
  id                 String                   @id @default(cuid())
  labResultId        String
  reviewerEmployeeId String
  decision           DiagnosticReviewDecision
  notes              String?                  @db.VarChar(1000)
  reviewedAt         DateTime                 @default(now()) @db.Timestamptz(3)
  labResult          LabResult                @relation(fields: [labResultId], references: [id], onDelete: Restrict)
  reviewer           Employee                 @relation("LabClinicalReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([labResultId, reviewerEmployeeId])
  @@index([reviewerEmployeeId, reviewedAt])
}

model LabCriticalCommunication {
  id                       String                       @id @default(cuid())
  labResultId              String
  status                   CriticalCommunicationStatus @default(PENDING)
  method                   CriticalCommunicationMethod
  communicatedToName       String                       @db.VarChar(160)
  readBackRequired         Boolean                      @default(true)
  readBackConfirmedAt      DateTime?                    @db.Timestamptz(3)
  notifiedByEmployeeId     String
  acknowledgedByEmployeeId String?
  notifiedAt               DateTime?                    @db.Timestamptz(3)
  acknowledgedAt           DateTime?                    @db.Timestamptz(3)
  escalatedAt              DateTime?                    @db.Timestamptz(3)
  resolutionNotes          String?                      @db.VarChar(1000)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(3)
  labResult                LabResult                    @relation(fields: [labResultId], references: [id], onDelete: Restrict)
  notifiedByEmployee       Employee                     @relation("LabCriticalNotifier", fields: [notifiedByEmployeeId], references: [id], onDelete: Restrict)
  acknowledgedByEmployee   Employee?                    @relation("LabCriticalAcknowledger", fields: [acknowledgedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([labResultId, createdAt])
}

// -----------------------------------------------------------------------------
// Phase 2C — Radiology (digital X-ray and ultrasound only)
// -----------------------------------------------------------------------------

model RadiologyProcedure {
  id                       String            @id @default(cuid())
  code                     String            @unique @db.VarChar(40)
  name                     String            @db.VarChar(180)
  modality                 RadiologyModality
  description              String?           @db.Text
  defaultDurationMinutes   Int?
  price                    Decimal           @db.Decimal(10, 2)
  currencyCode             String            @default("EGP") @db.Char(3)
  preparationInstructions  String?           @db.Text
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)
  orderItems               RadiologyOrderItem[]

  @@index([modality, isActive, name])
}

model RadiologyResource {
  id          String            @id @default(cuid())
  code        String            @unique @db.VarChar(40)
  name        String            @db.VarChar(120)
  modality    RadiologyModality
  location    String?           @db.VarChar(120)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  exams       RadiologyExam[]

  @@index([modality, isActive])
}

model RadiologyOrder {
  id                  String                 @id @default(cuid())
  orderReference      String                 @unique @db.VarChar(30)
  encounterId         String
  orderedByEmployeeId String
  status              RadiologyOrderStatus   @default(ORDERED)
  priority            DiagnosticOrderPriority @default(ROUTINE)
  clinicalNotes       String?                @db.VarChar(1000)
  orderedAt           DateTime               @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?              @db.Timestamptz(3)
  cancelledAt         DateTime?              @db.Timestamptz(3)
  cancellationReason  String?                @db.VarChar(500)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  encounter           Encounter              @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  orderedByEmployee   Employee               @relation("RadiologyOrderAuthor", fields: [orderedByEmployeeId], references: [id], onDelete: Restrict)
  items               RadiologyOrderItem[]

  @@index([encounterId, orderedAt])
  @@index([status, priority, orderedAt])
  @@index([orderedByEmployeeId, orderedAt])
}

model RadiologyOrderItem {
  id                  String                    @id @default(cuid())
  radiologyOrderId    String
  procedureId         String
  status              RadiologyOrderItemStatus  @default(PENDING)
  priceSnapshot       Decimal                   @db.Decimal(10, 2)
  currencyCode        String                    @default("EGP") @db.Char(3)
  instructions                         String?                   @db.VarChar(1000)
  preOrderPregnancyAssessment          RadiologyOrderPregnancyAssessment?
  preOrderPregnancyAssessmentNotes     String?                   @db.VarChar(1000)
  preOrderPregnancyAssessedByEmployeeId String?
  preOrderPregnancyAssessedAt          DateTime?                 @db.Timestamptz(3)
  createdAt                            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                            DateTime                  @updatedAt @db.Timestamptz(3)

  radiologyOrder                       RadiologyOrder            @relation(fields: [radiologyOrderId], references: [id], onDelete: Restrict)
  procedure                            RadiologyProcedure        @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  preOrderPregnancyAssessedByEmployee  Employee?                 @relation("RadiologyOrderItemPregnancyAssessor", fields: [preOrderPregnancyAssessedByEmployeeId], references: [id], onDelete: Restrict)
  exam                RadiologyExam?

  invoiceItems InvoiceItem[]
  @@index([radiologyOrderId, status])
  @@index([procedureId, createdAt])
  @@index([preOrderPregnancyAssessedByEmployeeId, preOrderPregnancyAssessedAt])
}

model RadiologyExam {
  id                    String                    @id @default(cuid())
  orderItemId           String                    @unique
  resourceId            String?
  status                RadiologyExamStatus       @default(SCHEDULED)
  scheduledStartsAt     DateTime?                 @db.Timestamptz(3)
  scheduledEndsAt       DateTime?                 @db.Timestamptz(3)
  startedAt             DateTime?                 @db.Timestamptz(3)
  performedAt           DateTime?                 @db.Timestamptz(3)
  performedByEmployeeId String?
  notes                 String?                   @db.VarChar(1000)
  preparationInstructionsSnapshot String?           @db.Text
  preparationStatus     RadiologyExamPreparationStatus @default(PENDING)
  preparationNotes      String?                   @db.VarChar(1000)
  preparationCheckedByEmployeeId String?            
  preparationCheckedAt  DateTime?                 @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(3)

  orderItem             RadiologyOrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  resource              RadiologyResource?        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  performedByEmployee  Employee?                 @relation("RadiologyExamPerformer", fields: [performedByEmployeeId], references: [id], onDelete: Restrict)
  preparationCheckedByEmployee Employee?             @relation("RadiologyExamPreparationChecker", fields: [preparationCheckedByEmployeeId], references: [id], onDelete: Restrict)
  identityVerifications IdentityVerification[]
  pregnancyScreening   RadiologyPregnancyScreening?
  report                RadiologyReport?

  @@index([status, scheduledStartsAt])
  @@index([resourceId, scheduledStartsAt, scheduledEndsAt])
  @@index([performedByEmployeeId, performedAt])
  @@index([preparationCheckedByEmployeeId, preparationCheckedAt])
}

model RadiologyPregnancyScreening {
  id                    String                  @id @default(cuid())
  examId                String                  @unique
  result                PregnancyScreeningResult
  screeningNotes        String?                 @db.VarChar(1000)
  recordedByEmployeeId  String
  screenedAt            DateTime                @default(now()) @db.Timestamptz(3)
  exam                  RadiologyExam           @relation(fields: [examId], references: [id], onDelete: Restrict)
  recordedByEmployee    Employee                @relation("PregnancyScreeningRecorder", fields: [recordedByEmployeeId], references: [id], onDelete: Restrict)
  reviewDecision        RadiologyPregnancyReviewDecision?
  reviewNotes           String?                 @db.VarChar(1000)
  reviewedByEmployeeId  String?
  reviewedAt            DateTime?               @db.Timestamptz(3)
  reviewedByEmployee    Employee?               @relation("PregnancyScreeningReviewer", fields: [reviewedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([result, screenedAt])
  @@index([recordedByEmployeeId, screenedAt])
  @@index([reviewedByEmployeeId, reviewedAt])
}

model RadiologyReport {
  id                   String                @id @default(cuid())
  examId               String                @unique
  status               RadiologyReportStatus @default(DRAFT)
  findings             String                @db.Text
  impression           String                @db.Text
  recommendations      String?               @db.Text
  isCritical            Boolean               @default(false)
  criticalReason        String?               @db.VarChar(1000)
  authoredByEmployeeId String
  approvedByEmployeeId String?
  authoredAt           DateTime              @default(now()) @db.Timestamptz(3)
  approvedAt           DateTime?             @db.Timestamptz(3)
  releasedAt           DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  exam                 RadiologyExam         @relation(fields: [examId], references: [id], onDelete: Restrict)
  authoredByEmployee   Employee              @relation("RadiologyReportAuthor", fields: [authoredByEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee   Employee?             @relation("RadiologyReportApprover", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  reviews              RadiologyReportReview[]
  clinicalReviews      RadiologyClinicalReview[]
  criticalCommunications RadiologyCriticalCommunication[]

  attachments Attachment[]
  @@index([status, authoredAt])
  @@index([approvedByEmployeeId, approvedAt])
}

model RadiologyReportReview {
  id                 String                         @id @default(cuid())
  reportId           String
  reviewerEmployeeId String
  decision           RadiologyReportApprovalDecision
  comments           String?                        @db.VarChar(1000)
  reviewedAt         DateTime                       @default(now()) @db.Timestamptz(3)
  report             RadiologyReport                @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reviewer           Employee                       @relation("RadiologyReportReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@index([reportId, reviewedAt])
  @@index([reviewerEmployeeId, reviewedAt])
}

model RadiologyClinicalReview {
  id                 String                   @id @default(cuid())
  reportId           String
  reviewerEmployeeId String
  decision           DiagnosticReviewDecision
  notes              String?                  @db.VarChar(1000)
  reviewedAt         DateTime                 @default(now()) @db.Timestamptz(3)
  report             RadiologyReport          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reviewer           Employee                 @relation("RadiologyClinicalReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@unique([reportId, reviewerEmployeeId])
  @@index([reviewerEmployeeId, reviewedAt])
}

model RadiologyCriticalCommunication {
  id                       String                       @id @default(cuid())
  reportId                 String
  status                   CriticalCommunicationStatus @default(PENDING)
  method                   CriticalCommunicationMethod
  communicatedToName       String                       @db.VarChar(160)
  readBackRequired         Boolean                      @default(true)
  readBackConfirmedAt      DateTime?                    @db.Timestamptz(3)
  notifiedByEmployeeId     String
  acknowledgedByEmployeeId String?
  notifiedAt               DateTime?                    @db.Timestamptz(3)
  acknowledgedAt           DateTime?                    @db.Timestamptz(3)
  escalatedAt              DateTime?                    @db.Timestamptz(3)
  resolutionNotes          String?                      @db.VarChar(1000)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(3)
  report                   RadiologyReport              @relation(fields: [reportId], references: [id], onDelete: Restrict)
  notifiedByEmployee       Employee                     @relation("RadiologyCriticalNotifier", fields: [notifiedByEmployeeId], references: [id], onDelete: Restrict)
  acknowledgedByEmployee   Employee?                    @relation("RadiologyCriticalAcknowledger", fields: [acknowledgedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([reportId, createdAt])
}


// Incoming outside-provider imaging results are held separately from clinic-performed
// RadiologyReport records. They remain scoped to the originating active Encounter.
model ExternalRadiologyReferral {
  id                         String                           @id @default(cuid())
  referralReference          String                           @unique @db.VarChar(30)
  encounterId                String
  procedureName              String                           @db.VarChar(180)
  reason                     String                           @db.VarChar(1000)
  externalFacilityName       String                           @db.VarChar(180)
  externalFacilityContact    String?                          @db.VarChar(100)
  status                     ExternalRadiologyReferralStatus  @default(REFERRED)
  consentId                  String                           @unique
  resultFindings             String?                          @db.Text
  resultImpression           String?                          @db.Text
  resultRecommendations      String?                          @db.Text
  resultPerformedAt          DateTime?                        @db.Timestamptz(3)
  resultReceivedAt           DateTime?                        @db.Timestamptz(3)
  resultReceivedByEmployeeId String?
  reviewDecision             DiagnosticReviewDecision?
  reviewNotes                String?                          @db.VarChar(1000)
  reviewedByEmployeeId      String?
  reviewedAt                 DateTime?                        @db.Timestamptz(3)
  createdByEmployeeId        String
  referredAt                 DateTime                         @default(now()) @db.Timestamptz(3)
  createdAt                  DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                         @updatedAt @db.Timestamptz(3)

  encounter                  Encounter                        @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  consent                    PatientConsent                   @relation("ExternalRadiologyReferralConsent", fields: [consentId], references: [id], onDelete: Restrict)
  createdByEmployee          Employee                         @relation("ExternalRadiologyReferralCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  resultReceivedByEmployee   Employee?                        @relation("ExternalRadiologyReferralResultReceiver", fields: [resultReceivedByEmployeeId], references: [id], onDelete: Restrict)
  reviewedByEmployee         Employee?                        @relation("ExternalRadiologyReferralReviewer", fields: [reviewedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([encounterId, referredAt])
  @@index([status, referredAt])
  @@index([resultReceivedByEmployeeId, resultReceivedAt])
  @@index([reviewedByEmployeeId, reviewedAt])
}


// -----------------------------------------------------------------------------
// Phase 2D — Billing, complaints, incidents, attachments, notifications, audit.
// Schema only. PostgreSQL migrations and writes are deferred to Phase 2E.
// -----------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum InvoiceItemSourceType {
  SERVICE
  LAB_TEST
  RADIOLOGY_PROCEDURE
  OTHER
}

enum PaymentMethod {
  CASH
  POS_CARD
  CLINIC_E_WALLET
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum DiscountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ComplaintChannel {
  WEBSITE
  PATIENT_PORTAL
  PHONE
  IN_PERSON
}

enum ComplaintCategory {
  APPOINTMENT
  STAFF_CONDUCT
  WAIT_TIME
  BILLING
  FACILITY
  SERVICE_QUALITY
  OTHER
}

enum ComplaintStatus {
  RECEIVED
  ACKNOWLEDGED
  IN_REVIEW
  RESOLVED
  CLOSED
  REJECTED
}

enum ComplaintEventType {
  RECEIVED
  ACKNOWLEDGED
  ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
  RESOLVED
  CLOSED
}

enum IncidentCategory {
  CLINICAL
  PATIENT_SAFETY
  FACILITY
  PRIVACY
  SECURITY
  OPERATIONAL
  OTHER
}

enum IncidentSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum AttachmentPurpose {
  PATIENT_DOCUMENT
  CLINICAL_DOCUMENT
  LAB_DOCUMENT
  RADIOLOGY_DOCUMENT
  COMPLAINT_EVIDENCE
  INCIDENT_EVIDENCE
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BROWSER_PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
  CANCELLED
}

enum AuditActorType {
  EMPLOYEE
  SYSTEM
  EXTERNAL
}

model Invoice {
  id                  String        @id @default(cuid())
  invoiceNumber       String        @unique @db.VarChar(30)
  patientId           String
  encounterId         String?       @unique
  externalLabIntakeId  String?       @unique
  status              InvoiceStatus @default(DRAFT)
  subtotal            Decimal       @db.Decimal(10, 2)
  discountTotal       Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  currencyCode        String        @default("EGP") @db.Char(3)
  issuedAt            DateTime?     @db.Timestamptz(3)
  voidedAt            DateTime?     @db.Timestamptz(3)
  voidReason          String?       @db.VarChar(500)
  createdByEmployeeId String
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter           Encounter?    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  externalLabIntake   ExternalLabIntake? @relation(fields: [externalLabIntakeId], references: [id], onDelete: Restrict)
  createdByEmployee   Employee      @relation("InvoiceCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict)
  items               InvoiceItem[]
  payments            Payment[]
  discountApprovals   DiscountApproval[]
  refunds             Refund[]
  complaints          Complaint[]

  @@index([patientId, createdAt])
  @@index([status, issuedAt])
  @@index([createdByEmployeeId, createdAt])
}

model InvoiceItem {
  id                    String                 @id @default(cuid())
  invoiceId             String
  sourceType            InvoiceItemSourceType
  description           String                 @db.VarChar(240)
  quantity              Int                    @default(1)
  unitPrice             Decimal                @db.Decimal(10, 2)
  discountAmount        Decimal                @default(0) @db.Decimal(10, 2)
  lineTotal             Decimal                @db.Decimal(10, 2)
  currencyCode          String                 @default("EGP") @db.Char(3)
  serviceCatalogId      String?
  labOrderItemId        String?                @unique
  radiologyOrderItemId  String?                @unique
  serviceCompletedAt   DateTime               @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)

  invoice               Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  serviceCatalog        ServiceCatalog?        @relation(fields: [serviceCatalogId], references: [id], onDelete: Restrict)
  labOrderItem          LabOrderItem?          @relation(fields: [labOrderItemId], references: [id], onDelete: Restrict)
  radiologyOrderItem    RadiologyOrderItem?    @relation(fields: [radiologyOrderItemId], references: [id], onDelete: Restrict)
  refundItems           RefundItem[]

  @@index([invoiceId, createdAt])
  @@index([serviceCatalogId])
}

model Payment {
  id                     String        @id @default(cuid())
  invoiceId              String
  amount                 Decimal       @db.Decimal(10, 2)
  currencyCode           String        @default("EGP") @db.Char(3)
  method                 PaymentMethod
  status                 PaymentStatus @default(COMPLETED)
  transactionReference   String?       @db.VarChar(120)
  receivedByEmployeeId   String
  paidAt                 DateTime      @default(now()) @db.Timestamptz(3)
  voidedAt               DateTime?     @db.Timestamptz(3)
  voidReason             String?       @db.VarChar(500)
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)

  invoice                Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedByEmployee     Employee      @relation("PaymentCollector", fields: [receivedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@index([receivedByEmployeeId, paidAt])
}

model DiscountApproval {
  id                    String                 @id @default(cuid())
  invoiceId             String
  amount                Decimal                @db.Decimal(10, 2)
  reason                String                 @db.VarChar(500)
  status                DiscountApprovalStatus @default(PENDING)
  requestedByEmployeeId String
  decidedByEmployeeId   String?
  requestedAt           DateTime               @default(now()) @db.Timestamptz(3)
  decidedAt             DateTime?              @db.Timestamptz(3)

  invoice               Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  requestedByEmployee   Employee               @relation("DiscountRequester", fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  decidedByEmployee     Employee?              @relation("DiscountDecider", fields: [decidedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([invoiceId, requestedAt])
  @@index([status, requestedAt])
  @@index([requestedByEmployeeId, requestedAt])
  @@index([decidedByEmployeeId, decidedAt])
}

model Refund {
  id                    String       @id @default(cuid())
  refundReference       String       @unique @db.VarChar(30)
  invoiceId             String
  amount                Decimal      @db.Decimal(10, 2)
  currencyCode          String       @default("EGP") @db.Char(3)
  reason                String       @db.VarChar(500)
  status                RefundStatus @default(PENDING)
  requestedByEmployeeId String
  approvedByEmployeeId  String?
  decidedByEmployeeId   String?
  completedByEmployeeId String?
  paymentMethod         PaymentMethod?
  transactionReference String?     @db.VarChar(120)
  requestedAt           DateTime     @default(now()) @db.Timestamptz(3)
  approvedAt            DateTime?    @db.Timestamptz(3)
  decidedAt             DateTime?    @db.Timestamptz(3)
  completedAt           DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  invoice               Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  requestedByEmployee   Employee     @relation("RefundRequester", fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  approvedByEmployee    Employee?    @relation("RefundApprover", fields: [approvedByEmployeeId], references: [id], onDelete: Restrict)
  decidedByEmployee     Employee?    @relation("RefundDecider", fields: [decidedByEmployeeId], references: [id], onDelete: Restrict)
  completedByEmployee   Employee?    @relation("RefundExecutor", fields: [completedByEmployeeId], references: [id], onDelete: Restrict)
  items                 RefundItem[]

  @@index([invoiceId, status, requestedAt])
  @@index([requestedByEmployeeId, requestedAt])
  @@index([approvedByEmployeeId, approvedAt])
  @@index([decidedByEmployeeId, decidedAt])
  @@index([completedByEmployeeId, completedAt])
}

model RefundItem {
  id             String      @id @default(cuid())
  refundId       String
  invoiceItemId  String
  amount         Decimal     @db.Decimal(10, 2)
  reason         String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  refund         Refund      @relation(fields: [refundId], references: [id], onDelete: Restrict)
  invoiceItem    InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)

  @@unique([refundId, invoiceItemId])
  @@index([invoiceItemId, createdAt])
}

model Complaint {
  id                    String            @id @default(cuid())
  referenceNumber       String            @unique @db.VarChar(30)
  patientId             String?
  appointmentId         String?
  invoiceId             String?
  channel               ComplaintChannel
  category              ComplaintCategory  @default(OTHER)
  status                ComplaintStatus    @default(RECEIVED)
  subject               String             @db.VarChar(180)
  description           String             @db.Text
  submitterName         String?            @db.VarChar(160)
  submitterPhone        String?            @db.VarChar(30)
  submitterEmail        String?            @db.VarChar(254)
  createdByEmployeeId   String?
  assignedToEmployeeId String?
  receivedAt            DateTime           @default(now()) @db.Timestamptz(3)
  acknowledgedAt        DateTime?          @db.Timestamptz(3)
  resolvedAt            DateTime?          @db.Timestamptz(3)
  closedAt              DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  patient               Patient?           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment           Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  invoice               Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdByEmployee     Employee?          @relation("ComplaintRecorder", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  assignedToEmployee    Employee?          @relation("ComplaintAssignee", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  events                ComplaintEvent[]
  attachments           Attachment[]

  @@index([patientId, receivedAt])
  @@index([status, receivedAt])
  @@index([assignedToEmployeeId, status])
  @@index([createdByEmployeeId, receivedAt])
}

model ComplaintEvent {
  id                String             @id @default(cuid())
  complaintId       String
  eventType         ComplaintEventType
  fromStatus        ComplaintStatus?
  toStatus          ComplaintStatus?
  note              String?            @db.VarChar(1000)
  actorEmployeeId   String?
  occurredAt        DateTime           @default(now()) @db.Timestamptz(3)

  complaint         Complaint          @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  actorEmployee     Employee?          @relation("ComplaintEventActor", fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([complaintId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
}

model IncidentReport {
  id                    String           @id @default(cuid())
  referenceNumber       String           @unique @db.VarChar(30)
  category              IncidentCategory
  severity              IncidentSeverity
  status                IncidentStatus   @default(REPORTED)
  patientId             String?
  encounterId           String?
  reportedByEmployeeId  String
  assignedToEmployeeId String?
  occurredAt            DateTime         @db.Timestamptz(3)
  reportedAt            DateTime         @default(now()) @db.Timestamptz(3)
  summary               String           @db.VarChar(180)
  description           String           @db.Text
  immediateActions      String?          @db.Text
  resolutionNotes       String?          @db.Text
  resolvedAt            DateTime?        @db.Timestamptz(3)
  closedAt              DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  patient               Patient?         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter             Encounter?       @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  reportedByEmployee    Employee         @relation("IncidentReporter", fields: [reportedByEmployeeId], references: [id], onDelete: Restrict)
  assignedToEmployee    Employee?        @relation("IncidentAssignee", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  attachments           Attachment[]

  @@index([status, severity, reportedAt])
  @@index([patientId, occurredAt])
  @@index([encounterId, occurredAt])
  @@index([assignedToEmployeeId, status])
}

model Attachment {
  id                    String           @id @default(cuid())
  patientId             String?
  encounterId           String?
  labResultId           String?
  radiologyReportId     String?
  complaintId           String?
  incidentReportId      String?
  purpose               AttachmentPurpose
  originalFileName      String           @db.VarChar(255)
  storageKey            String           @unique @db.VarChar(500)
  mimeType              String           @db.VarChar(100)
  sizeBytes             BigInt
  checksumSha256        String?          @db.Char(64)
  uploadedByEmployeeId  String?
  uploadedAt            DateTime         @default(now()) @db.Timestamptz(3)

  patient               Patient?         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter             Encounter?       @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  labResult             LabResult?       @relation(fields: [labResultId], references: [id], onDelete: Restrict)
  radiologyReport       RadiologyReport? @relation(fields: [radiologyReportId], references: [id], onDelete: Restrict)
  complaint             Complaint?       @relation(fields: [complaintId], references: [id], onDelete: Restrict)
  incidentReport        IncidentReport?  @relation(fields: [incidentReportId], references: [id], onDelete: Restrict)
  uploadedByEmployee    Employee?        @relation("AttachmentUploader", fields: [uploadedByEmployeeId], references: [id], onDelete: SetNull)
  guardianVerificationFor PatientRelationship? @relation("PatientGuardianEvidence")

  @@index([patientId, uploadedAt])
  @@index([encounterId, uploadedAt])
  @@index([labResultId])
  @@index([radiologyReportId])
  @@index([complaintId])
  @@index([incidentReportId])
  @@index([uploadedByEmployeeId, uploadedAt])
}

model Notification {
  id                    String              @id @default(cuid())
  patientId             String?
  employeeId            String?
  channel               NotificationChannel
  status                NotificationStatus  @default(PENDING)
  title                 String              @db.VarChar(160)
  message               String              @db.VarChar(1000)
  actionPath            String?             @db.VarChar(300)
  scheduledAt           DateTime            @default(now()) @db.Timestamptz(3)
  sentAt                DateTime?           @db.Timestamptz(3)
  deliveredAt           DateTime?           @db.Timestamptz(3)
  readAt                DateTime?           @db.Timestamptz(3)
  failureCode           String?             @db.VarChar(100)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)

  patient               Patient?            @relation("PatientNotificationRecipient", fields: [patientId], references: [id], onDelete: Cascade)
  employee              Employee?           @relation("EmployeeNotificationRecipient", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([patientId, status, scheduledAt])
  @@index([employeeId, status, scheduledAt])
  @@index([channel, status, scheduledAt])
}

model AuditLog {
  id                String         @id @default(cuid())
  actorType         AuditActorType
  actorEmployeeId   String?
  action            String         @db.VarChar(60)
  entityType        String         @db.VarChar(80)
  entityId          String         @db.VarChar(80)
  reason            String?        @db.VarChar(500)
  requestId         String?        @db.VarChar(100)
  ipAddress         String?        @db.VarChar(45)
  occurredAt        DateTime       @default(now()) @db.Timestamptz(3)

  actorEmployee     Employee?      @relation("AuditActor", fields: [actorEmployeeId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorEmployeeId, occurredAt])
  @@index([action, occurredAt])
}


// -----------------------------------------------------------------------------
// Phase 3A — Authentication, employee roles, and patient account delegation.
// -----------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique @db.VarChar(254)
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  sessions        Session[]
  accounts        Account[]
  employeeAccount EmployeeAccount?
  patientAccount  PatientAccount?

  @@map("auth_user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verification")
}

// -----------------------------------------------------------------------------
// Explicit 1:1 identity links. User is not the medical or employee record.
// A user may have an employee link, a patient link, or both where appropriate.
// -----------------------------------------------------------------------------

model EmployeeAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique
  employeeId           String   @unique
  linkedByEmployeeId   String?
  linkedAt             DateTime @default(now()) @db.Timestamptz(3)
  verifiedAt           DateTime? @db.Timestamptz(3)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  employee             Employee @relation("EmployeeAuthAccount", fields: [employeeId], references: [id], onDelete: Restrict)
  linkedBy             Employee? @relation("EmployeeAccountLinker", fields: [linkedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([linkedByEmployeeId, linkedAt])
}

model PatientAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique
  patientId            String   @unique
  linkedAt             DateTime @default(now()) @db.Timestamptz(3)
  verifiedAt           DateTime? @db.Timestamptz(3)
  verifiedByEmployeeId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  verifiedByEmployee   Employee? @relation("PatientAccountVerifier", fields: [verifiedByEmployeeId], references: [id], onDelete: Restrict)

  @@index([verifiedByEmployeeId, verifiedAt])
}

// -----------------------------------------------------------------------------
// Employee role assignment. The domain role is not a client-writable auth field.
// One current assignment row per employee/role; grant/revoke events are retained
// in AuditLog when the application changes this row.
// -----------------------------------------------------------------------------

model EmployeeRoleAssignment {
  id                 String                        @id @default(cuid())
  employeeId         String
  role               EmployeeRole
  status             EmployeeRoleAssignmentStatus @default(ACTIVE)
  grantedByEmployeeId String?
  revokedByEmployeeId String?
  reason             String?                       @db.VarChar(500)
  grantedAt          DateTime                      @default(now()) @db.Timestamptz(3)
  revokedAt          DateTime?                     @db.Timestamptz(3)
  createdAt          DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(3)

  employee           Employee  @relation("EmployeeRoleAssignments", fields: [employeeId], references: [id], onDelete: Restrict)
  grantedBy          Employee? @relation("EmployeeRoleGrantors", fields: [grantedByEmployeeId], references: [id], onDelete: Restrict)
  revokedBy          Employee? @relation("EmployeeRoleRevokers", fields: [revokedByEmployeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, role])
  @@index([employeeId, status])
  @@index([role, status])
}

// -----------------------------------------------------------------------------
// Patient delegation. subjectPatientId is the patient whose data is accessed;
// granteePatientId is the related patient profile receiving access.
// The composite relation guarantees the PatientRelationship direction:
// PatientRelationship.patientId = subject and relatedPatientId = grantee.
// Runtime policy must still verify legal-guardian status or adult approval.
// -----------------------------------------------------------------------------

model PatientAccessGrant {
  id                    String                    @id @default(cuid())
  subjectPatientId      String
  granteePatientId      String
  requestedByEmployeeId String?
  approvedByPatientId   String?
  verifiedByEmployeeId  String?
  status                PatientAccessGrantStatus @default(PENDING)
  reason                String?                   @db.VarChar(500)
  requestedAt           DateTime                  @default(now()) @db.Timestamptz(3)
  approvedAt            DateTime?                 @db.Timestamptz(3)
  verifiedAt            DateTime?                 @db.Timestamptz(3)
  expiresAt             DateTime?                 @db.Timestamptz(3)
  revokedAt             DateTime?                 @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(3)

  subjectPatient        Patient  @relation("PatientAccessGrantSubject", fields: [subjectPatientId], references: [id], onDelete: Restrict)
  granteePatient        Patient  @relation("PatientAccessGrantGrantee", fields: [granteePatientId], references: [id], onDelete: Restrict)
  relationship          PatientRelationship @relation(fields: [subjectPatientId, granteePatientId], references: [patientId, relatedPatientId], onDelete: Restrict)
  requestedByEmployee   Employee? @relation("PatientAccessGrantEmployeeRequester", fields: [requestedByEmployeeId], references: [id], onDelete: Restrict)
  approvedByPatient     Patient? @relation("PatientAccessGrantPatientApprover", fields: [approvedByPatientId], references: [id], onDelete: Restrict)
  verifiedByEmployee    Employee? @relation("PatientAccessGrantVerifier", fields: [verifiedByEmployeeId], references: [id], onDelete: Restrict)
  permissions           PatientAccessGrantPermission[]

  @@unique([subjectPatientId, granteePatientId])
  @@index([subjectPatientId, status])
  @@index([granteePatientId, status])
  @@index([expiresAt])
}

model PatientAccessGrantPermission {
  id        String             @id @default(cuid())
  grantId   String
  scope     PatientAccessScope
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  grant     PatientAccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@unique([grantId, scope])
  @@index([scope])
}

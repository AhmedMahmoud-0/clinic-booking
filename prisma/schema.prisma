  encounter           Encounter?

  @@unique([doctorId, queueDate, queueNumber])
  @@index([doctorId, queueDate, status, queueNumber])
  @@index([patientId, queueDate])
  @@index([createdByEmployeeId, createdAt])
}

model IdentityVerification {
  id                    String                     @id @default(cuid())
  patientId             String
  appointmentId         String?
  encounterId           String?
  radiologyExamId       String?
  firstElement          IdentityElementType

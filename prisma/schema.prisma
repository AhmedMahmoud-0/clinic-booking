  changedByEmployee   Employee?                @relation("AppointmentStatusActor", fields: [changedByEmployeeId], references: [id], onDelete: SetNull)
  changedByPatient    Patient?                 @relation("AppointmentStatusPatientActor", fields: [changedByPatientId], references: [id], onDelete: SetNull)

  @@index([appointmentId, changedAt])
  @@index([changedByEmployeeId, changedAt])
  @@index([changedByPatientId, changedAt])
}

model QueueEntry {
  id                  String           @id @default(cuid())
  patientId           String
  doctorId            String
  appointmentId       String?          @unique
  queueDate           DateTime         @db.Date
  queueNumber         Int
  type                QueueEntryType
  status              QueueEntryStatus @default(WAITING)
  checkedInAt         DateTime         @default(now()) @db.Timestamptz(3)

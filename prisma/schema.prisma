  @@index([appointmentId, verifiedAt])
  @@index([encounterId, verifiedAt])
  @@index([radiologyExamId, verifiedAt])
  @@index([performedByEmployeeId, verifiedAt])
}

model Encounter {
  id                  String          @id @default(cuid())

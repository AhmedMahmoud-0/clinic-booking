// MERUNO Phase 3A — Authentication and account-linking schema fragment.
// This is a PATCH FRAGMENT, not a standalone Prisma schema.
// Follow docs/authentication/phase-3a-schema-placement.md for exact placement.

// -----------------------------------------------------------------------------
// Enums — append with the existing enums near the top of schema.prisma.
// -----------------------------------------------------------------------------

enum EmployeeRole {
  RECEPTION
  DOCTOR
  NURSE
  LAB_STAFF
  RADIOLOGY_STAFF
  RADIOLOGIST
  CASHIER
  CLINIC_MANAGER
  SYSTEM_ADMIN
}

enum EmployeeRoleAssignmentStatus {
  ACTIVE
  REVOKED
}

enum PatientAccessGrantStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  EXPIRED
}

enum PatientAccessScope {
  VIEW_PROFILE
  MANAGE_PROFILE
  BOOK_APPOINTMENTS
  MANAGE_APPOINTMENTS
  VIEW_BILLING
  VIEW_MEDICAL_RECORDS
  VIEW_DIAGNOSTIC_RESULTS
}


{
  "name": "clinic-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate --config=./prisma7.config.ts",
    "db:generate": "prisma generate --config=./prisma7.config.ts",
    "health:check": "node scripts/check-health.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "db:migration:preview": "node scripts/create-initial-migration.mjs",
    "db:migrate:status": "prisma migrate status --config=./prisma7.config.ts",
    "db:seed": "prisma db execute --config=./prisma7.config.ts --file=./prisma/seed.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "1.7.18",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.68.0",
    "next": "16.4.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@playwright/test": "1.64.1",
    "vitest": "4.1.11"
  }
}
